# Files/directories excluded from the WordPress.org release ZIP.
# Keep this in sync with the packaging step — this is the reproducible
# definition of what ships, so the ZIP never again depends on someone
# remembering the exclude list by hand.

# Version control / CI
.git
.github
.gitignore
.gitattributes
.svn

# Dependencies (not needed at runtime; build/ ships instead)
node_modules
vendor

# Sources SHIP. src/, includes/public/blocks/*/src, the shared
# includes/public/blocks/custom-components and package.json (the build
# tools) are the human-readable source of every build/ file. readme.txt
# ("Source code and build process") promises they are inside the plugin,
# and WP.org guideline 4 needs them there - there is no public repo link
# to point to instead. Never add them back to this list.

# Build/dev tooling and metadata
package-lock.json
composer.json
composer.lock
webpack.config.js
.eslintrc
.eslintrc.js
.eslintrc.json
.prettierrc
.prettierrc.js
.prettierrc.json
.editorconfig
phpcs.xml
phpcs.xml.dist
.phpcs.xml
.phpcs.xml.dist

# Generated/debug artefacts
*.map
.DS_Store
Thumbs.db
*.log
*.zip
.env
.env.*

# Tests / CI
tests
test
phpunit.xml
phpunit.xml.dist
.travis.yml
