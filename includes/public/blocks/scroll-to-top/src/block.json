{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shapeblock/scroll-to-top",
	"version": "0.1.0",
	"title": "Scroll Top",
	"category": "shapeblock",
	"description": "A floating scroll-to-top button that appears after scrolling and smoothly returns to the top.",
	"keywords": [ "scroll", "top", "back to top", "button" ],
	"example": {},
	"supports": {
		"html": false,
		"align": [ "left", "center", "right", "wide", "full" ]
	},
	"textdomain": "shapeblock",
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"attributes": {
		"advPadding": { "type": "object", "default": { "top": "", "right": "", "bottom": "", "left": "" } },
		"advPaddingTablet": { "type": "object", "default": { "top": "", "right": "", "bottom": "", "left": "" } },
		"advPaddingMobile": { "type": "object", "default": { "top": "", "right": "", "bottom": "", "left": "" } },
		"advMargin": { "type": "object", "default": { "top": "", "right": "", "bottom": "", "left": "" } },
		"advMarginTablet": { "type": "object", "default": { "top": "", "right": "", "bottom": "", "left": "" } },
		"advMarginMobile": { "type": "object", "default": { "top": "", "right": "", "bottom": "", "left": "" } },
		"advBgColor": { "type": "string", "default": "" },
		"advBgGradient": { "type": "string", "default": "" },
		"blockId": { "type": "string", "default": "" },
		"scrollIcon": { "type": "string", "default": "shapeblock-icon-arrow-up" },
		"position": { "type": "string", "default": "right" },
		"offsetX": { "type": "string", "default": "" },
		"offsetY": { "type": "string", "default": "" },
		"showAfter": { "type": "string", "default": "" },
		"buttonSize": { "type": "string", "default": "" },
		"buttonSizeTablet": { "type": "string", "default": "" },
		"buttonSizeMobile": { "type": "string", "default": "" },
		"iconSize": { "type": "string", "default": "" },
		"iconSizeTablet": { "type": "string", "default": "" },
		"iconSizeMobile": { "type": "string", "default": "" },
		"color": { "type": "string", "default": "" },
		"bgColor": { "type": "string", "default": "" },
		"colorHover": { "type": "string", "default": "" },
		"bgColorHover": { "type": "string", "default": "" },
		"sttBorder": { "type": "object", "default": {} },
		"sttRadius": { "type": "object", "default": {} },
		"sttBoxShadow": { "type": "object", "default": {} },
		"sttPadding": { "type": "object", "default": {} },
		"sttPaddingTablet": { "type": "object" },
		"sttPaddingMobile": { "type": "object" },
	"hideDesktop": { "type": "boolean", "default": false },
	"hideTablet": { "type": "boolean", "default": false },
	"hideMobile": { "type": "boolean", "default": false }
}
}
