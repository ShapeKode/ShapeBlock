{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easy-elements-for-gutenberg/icon",
	"version": "0.1.0",
	"title": "Icon",
	"category": "easy-elements-for-gutenberg",
	"description": "A single icon with color, size, background, border, rotation and link — like Elementor's Icon widget.",
	"keywords": [ "icon", "svg", "glyph", "symbol" ],
	"example": {},
	"supports": {
		"html": false,
		"align": [ "left", "center", "right", "wide", "full" ],
		"spacing": {
			"padding": [ "top", "bottom", "left", "right" ],
			"margin": [ "top", "bottom", "left", "right" ]
		}
	},
	"textdomain": "easy-elements-for-gutenberg",
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"attributes": {
		"blockId": { "type": "string", "default": "" },

		"icon": { "type": "string", "default": "eelfg-icon-favorite" },
		"view": { "type": "string", "default": "default" },
		"shape": { "type": "string", "default": "circle" },
		"iconUrl": { "type": "string", "default": "" },
		"iconTarget": { "type": "boolean", "default": false },
		"iconNofollow": { "type": "boolean", "default": false },
		"alignment": { "type": "string", "default": "center" },

		"iconColor": { "type": "string", "default": "" },
		"iconSize": { "type": "string", "default": "48" },
		"iconRotation": { "type": "string", "default": "" },
		"iconBg": { "type": "string", "default": "" },
		"iconPadding": { "type": "object" },
		"iconBorder": { "type": "object", "default": { "width": 0, "color": "", "style": "solid" } },
		"iconBorderRadius": { "type": "object", "default": { "top": "", "right": "", "bottom": "", "left": "" } },
		"iconBoxShadow": { "type": "object", "default": { "x": 0, "y": 0, "b": 0, "s": 0, "c": "rgba(0, 0, 0, 0)" } },

		"iconColorHover": { "type": "string", "default": "" },
		"iconBgHover": { "type": "string", "default": "" },
		"iconBorderHover": { "type": "object", "default": { "width": 0, "color": "", "style": "solid" } },
		"iconRotationHover": { "type": "string", "default": "" }
	}
}
