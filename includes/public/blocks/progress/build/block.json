{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "shapeblock/progress",
  "version": "0.1.0",
  "title": "Progress Bar",
  "category": "shapeblock",
  "description": "A progress / skill bar with title and percent — two layout styles and full styling.",
  "keywords": [
    "progress",
    "bar",
    "skill",
    "percent",
    "meter"
  ],
  "example": {},
  "supports": {
    "html": false,
    "align": [
      "left",
      "center",
      "right",
      "wide",
      "full"
    ]
  },
  "textdomain": "shapeblock",
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "attributes": {
    "advPadding": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "advPaddingTablet": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "advPaddingMobile": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "advMargin": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "advMarginTablet": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "advMarginMobile": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "advBgColor": {
      "type": "string",
      "default": ""
    },
    "advBgGradient": {
      "type": "string",
      "default": ""
    },
    "blockId": {
      "type": "string",
      "default": ""
    },
    "selectStyle": {
      "type": "string",
      "default": "style1"
    },
    "title": {
      "type": "string",
      "default": "Web Designer"
    },
    "percent": {
      "type": "number",
      "default": 50
    },
    "progressColor": {
      "type": "string",
      "default": ""
    },
    "progressBarColor": {
      "type": "string",
      "default": ""
    },
    "style2BgColor": {
      "type": "string",
      "default": ""
    },
    "style2BgGradient": {
      "type": "string",
      "default": ""
    },
    "progressHeight": {
      "type": "string",
      "default": ""
    },
    "progressHeightTablet": {
      "type": "string",
      "default": ""
    },
    "progressHeightMobile": {
      "type": "string",
      "default": ""
    },
    "progressRadius": {
      "type": "string",
      "default": ""
    },
    "titleColor": {
      "type": "string",
      "default": ""
    },
    "titleTypography": {
      "type": "object",
      "default": {
        "fontFamily": "",
        "fontSize": "",
        "fontWeight": "",
        "fontStyle": "",
        "textTransform": "",
        "lineHeight": "",
        "letterSpacing": ""
      }
    },
    "titleTypographyTablet": {
      "type": "object",
      "default": {}
    },
    "titleTypographyMobile": {
      "type": "object",
      "default": {}
    },
    "percentColor": {
      "type": "string",
      "default": ""
    },
    "percentTypography": {
      "type": "object",
      "default": {
        "fontFamily": "",
        "fontSize": "",
        "fontWeight": "",
        "fontStyle": "",
        "textTransform": "",
        "lineHeight": "",
        "letterSpacing": ""
      }
    },
    "percentTypographyTablet": {
      "type": "object",
      "default": {}
    },
    "percentTypographyMobile": {
      "type": "object",
      "default": {}
    },
    "hideDesktop": {
      "type": "boolean",
      "default": false
    },
    "hideTablet": {
      "type": "boolean",
      "default": false
    },
    "hideMobile": {
      "type": "boolean",
      "default": false
    }
  }
}