{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "easy-elements-for-gutenberg/icon-box",
  "version": "0.1.0",
  "title": "Icon Box",
  "category": "easy-elements-for-gutenberg",
  "description": "Icon boxes with the icon on top, then title and description — icon, number or image supported.",
  "keywords": [
    "icon box",
    "icon",
    "feature",
    "service",
    "box"
  ],
  "example": {},
  "supports": {
    "html": false,
    "align": [
      "left",
      "center",
      "right",
      "wide",
      "full"
    ]
  },
  "textdomain": "easy-elements-for-gutenberg",
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "showIcon": {
      "type": "boolean",
      "default": true
    },
    "iconType": {
      "type": "string",
      "default": "icon"
    },
    "icon": {
      "type": "string",
      "default": "eelfg-icon-favorite"
    },
    "number": {
      "type": "string",
      "default": "01"
    },
    "image": {
      "type": "object",
      "default": {}
    },
    "title": {
      "type": "string",
      "default": "Lightning Fast"
    },
    "desc": {
      "type": "string",
      "default": "Your site loads in seconds with our highly optimized structure."
    },
    "boxAlign": {
      "type": "string",
      "default": "center"
    },
    "boxVAlign": {
      "type": "string",
      "default": "center"
    },
    "iconView": {
      "type": "string",
      "default": "stracked"
    },
    "iconShape": {
      "type": "string",
      "default": "rounded"
    },
    "titleTag": {
      "type": "string",
      "default": "h3"
    },
    "listBgColor": {
      "type": "string",
      "default": ""
    },
    "listBgGradient": {
      "type": "string",
      "default": ""
    },
    "feaItemGap": {
      "type": "string",
      "default": ""
    },
    "feaItemGapTablet": {
      "type": "string",
      "default": ""
    },
    "feaItemGapMobile": {
      "type": "string",
      "default": ""
    },
    "feaMiddleGap": {
      "type": "string",
      "default": "20"
    },
    "feaMiddleGapTablet": {
      "type": "string",
      "default": ""
    },
    "feaMiddleGapMobile": {
      "type": "string",
      "default": ""
    },
    "feaListBorder": {
      "type": "object",
      "default": {
        "width": 0,
        "color": "",
        "style": "solid"
      }
    },
    "feaListBorderRadius": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "feaListPadding": {
      "type": "object"
    },
    "feaListPaddingTablet": {
      "type": "object"
    },
    "feaListPaddingMobile": {
      "type": "object"
    },
    "feaBlockMargin": {
      "type": "object"
    },
    "feaBlockMarginTablet": {
      "type": "object"
    },
    "feaBlockMarginMobile": {
      "type": "object"
    },
    "iconColor": {
      "type": "string",
      "default": ""
    },
    "iconBgColor": {
      "type": "string",
      "default": ""
    },
    "iconBgGradient": {
      "type": "string",
      "default": ""
    },
    "iconSize": {
      "type": "string",
      "default": ""
    },
    "iconSizeTablet": {
      "type": "string",
      "default": ""
    },
    "iconSizeMobile": {
      "type": "string",
      "default": ""
    },
    "iconBoxSize": {
      "type": "string",
      "default": ""
    },
    "iconBoxSizeTablet": {
      "type": "string",
      "default": ""
    },
    "iconBoxSizeMobile": {
      "type": "string",
      "default": ""
    },
    "iconAlignment": {
      "type": "string",
      "default": "center"
    },
    "iconShadow": {
      "type": "object",
      "default": {
        "x": 0,
        "y": 0,
        "b": 0,
        "s": 0,
        "c": "rgba(0, 0, 0, 0)"
      }
    },
    "iconBorder": {
      "type": "object",
      "default": {
        "width": 0,
        "color": "",
        "style": "solid"
      }
    },
    "iconRadius": {
      "type": "object",
      "default": {
        "top": "",
        "right": "",
        "bottom": "",
        "left": ""
      }
    },
    "titleColor": {
      "type": "string",
      "default": ""
    },
    "titleTypography": {
      "type": "object",
      "default": {
        "fontFamily": "",
        "fontSize": "",
        "fontWeight": "",
        "fontStyle": "",
        "textTransform": "",
        "lineHeight": "",
        "letterSpacing": ""
      }
    },
    "titleTypographyTablet": {
      "type": "object",
      "default": {}
    },
    "titleTypographyMobile": {
      "type": "object",
      "default": {}
    },
    "titlePadding": {
      "type": "object"
    },
    "titlePaddingTablet": {
      "type": "object"
    },
    "titlePaddingMobile": {
      "type": "object"
    },
    "descColor": {
      "type": "string",
      "default": ""
    },
    "descTypography": {
      "type": "object",
      "default": {
        "fontFamily": "",
        "fontSize": "",
        "fontWeight": "",
        "fontStyle": "",
        "textTransform": "",
        "lineHeight": "",
        "letterSpacing": ""
      }
    },
    "descTypographyTablet": {
      "type": "object",
      "default": {}
    },
    "descTypographyMobile": {
      "type": "object",
      "default": {}
    }
  }
}