{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "easy-elements-for-gutenberg/menu",
	"version": "0.1.0",
	"title": "Menu",
	"category": "easy-elements-for-gutenberg",
	"description": "Build a navigation menu inside the block — add links and dropdowns, pick pages, descriptions, new-tab links, plus a responsive mobile menu.",
	"keywords": [ "menu", "nav", "navigation", "links", "dropdown" ],
	"example": {},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"textdomain": "easy-elements-for-gutenberg",
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"attributes": {
		"blockId": { "type": "string", "default": "" },
		"items": { "type": "array", "default": [] },
		"layout": { "type": "string", "default": "horizontal" },
		"alignment": { "type": "string", "default": "left" },
		"itemGap": { "type": "string", "default": "" },
		"gapTablet": { "type": "string", "default": "" },
		"gapMobile": { "type": "string", "default": "" },
		"textColor": { "type": "string", "default": "" },
		"hoverColor": { "type": "string", "default": "" },
		"activeColor": { "type": "string", "default": "" },
		"descriptionColor": { "type": "string", "default": "" },
		"itemBgColor": { "type": "string", "default": "" },
		"itemBgHoverColor": { "type": "string", "default": "" },
		"itemBgActiveColor": { "type": "string", "default": "" },
		"itemBgGradient": { "type": "string", "default": "" },
		"itemBgHoverGradient": { "type": "string", "default": "" },
		"itemBgActiveGradient": { "type": "string", "default": "" },
		"dropdownBg": { "type": "string", "default": "" },
		"dropdownBgGradient": { "type": "string", "default": "" },
		"dropdownTextColor": { "type": "string", "default": "" },
		"dropdownHoverColor": { "type": "string", "default": "" },
		"dropdownHoverBg": { "type": "string", "default": "" },
		"dropdownHoverBgGradient": { "type": "string", "default": "" },
		"mobileTextColor": { "type": "string", "default": "" },
		"mobileHoverColor": { "type": "string", "default": "" },
		"mobileActiveColor": { "type": "string", "default": "" },
		"mobileBgColor": { "type": "string", "default": "" },
		"mobileBgHoverColor": { "type": "string", "default": "" },
		"mobileBgActiveColor": { "type": "string", "default": "" },
		"mobileBgGradient": { "type": "string", "default": "" },
		"mobileBgHoverGradient": { "type": "string", "default": "" },
		"mobileBgActiveGradient": { "type": "string", "default": "" },
		"dropdownIcon": { "type": "string", "default": "caret" },
		"fontFamily": { "type": "string", "default": "" },
		"fontSize": { "type": "string", "default": "" },
		"fontWeight": { "type": "string", "default": "" },
		"textTransform": { "type": "string", "default": "" },
		"mobileEnable": { "type": "boolean", "default": true },
		"mobileMode": { "type": "string", "default": "mobile" },
		"submenuTrigger": { "type": "string", "default": "hover" },
		"menuWrap": { "type": "boolean", "default": true },
		"mobileBreakpoint": { "type": "number", "default": 782 },
		"toggleColor": { "type": "string", "default": "" },
		"drawerSide": { "type": "string", "default": "right" },
		"drawerWidth": { "type": "number", "default": 320 },
		"drawerBg": { "type": "string", "default": "" }
	}
}
