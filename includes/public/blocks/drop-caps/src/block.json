{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shapeblock/drop-caps",
	"version": "1.0.1",
	"title": "Drop Caps",
	"category": "shapeblock",
	"description": "A paragraph that opens with a large first letter across several lines, plain, in a box, outlined or as an outlined letter, with optional newspaper columns.",
	"keywords": [
		"drop cap",
		"initial",
		"first letter",
		"paragraph",
		"text",
		"editorial"
	],
	"example": {},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"textdomain": "shapeblock",
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"attributes": {
		"advPadding": {
			"type": "object",
			"default": {
				"top": "",
				"right": "",
				"bottom": "",
				"left": ""
			}
		},
		"advPaddingTablet": {
			"type": "object",
