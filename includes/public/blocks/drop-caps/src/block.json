		"text": {
			"type": "string",
			"default": "When the first shipment of walnut came in from a mill outside Lancaster, nobody at the shop had built anything bigger than a bookshelf. Three years and four hundred tables later, the same sawhorses still stand by the loading door, and we still check every board by hand before it goes on the bench."
		},
		"capStyle": {
			"type": "string",
			"default": "plain"
