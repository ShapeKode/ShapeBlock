{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shapeblock/image-comparison",
	"version": "1.0.0",
	"title": "Image Comparison",
	"category": "shapeblock",
	"description": "A before / after image comparison slider with a draggable handle — horizontal or vertical.",
	"keywords": [
		"before",
		"after",
		"compare",
		"comparison",
		"slider"
	],
	"example": {},
	"supports": {
		"html": false,
		"align": [
			"left",
			"center",
			"right",
			"wide",
			"full"
		]
	},
	"textdomain": "shapeblock",
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"attributes": {
		"advPadding": {
			"type": "object",
			"default": {
				"top": "",
				"right": "",
				"bottom": "",
				"left": ""
			}
		},
		"advPaddingTablet": {
			"type": "object",
			"default": {
				"top": "",
				"right": "",
				"bottom": "",
				"left": ""
			}
		},
		"advPaddingMobile": {
			"type": "object",
			"default": {
				"top": "",
				"right": "",
				"bottom": "",
				"left": ""
			}
		},
		"advMargin": {
			"type": "object",
			"default": {
				"top": "",
				"right": "",
				"bottom": "",
				"left": ""
			}
		},
		"advMarginTablet": {
			"type": "object",
			"default": {
				"top": "",
				"right": "",
				"bottom": "",
				"left": ""
			}
		},
		"advMarginMobile": {
			"type": "object",
			"default": {
				"top": "",
				"right": "",
				"bottom": "",
				"left": ""
			}
		},
		"advBgColor": {
			"type": "string",
			"default": ""
		},
		"advBgGradient": {
			"type": "string",
			"default": ""
		},
		"blockId": {
			"type": "string",
			"default": ""
		},
		"beforeImage": {
			"type": "object",
			"default": {}
		},
		"afterImage": {
			"type": "object",
			"default": {}
		},
		"containerBorder": {
			"type": "object",
			"default": {
				"width": 0,
				"color": "",
				"style": "solid"
			}
		},
		"containerShadow": {
			"type": "object",
			"default": {
				"x": 0,
				"y": 0,
				"b": 0,
				"s": 0,
				"c": ""
			}
		},
		"handleStyle": {
			"type": "string",
			"default": "circle"
		},
		"handleIcon": {
			"type": "string",
			"default": "triangles"
		},
		"handleColor": {
			"type": "string",
			"default": ""
		},
		"handleBg": {
			"type": "string",
			"default": ""
		},
		"handleBgGradient": {
			"type": "string",
			"default": ""
		},
		"handleIconColor": {
			"type": "string",
			"default": ""
		},
		"handleSize": {
			"type": "string",
			"default": ""
		},
		"handleLine": {
			"type": "string",
			"default": ""
		},
		"handleShadow": {
			"type": "boolean",
			"default": true
		},
		"orientation": {
			"type": "string",
			"default": "horizontal"
		},
		"offset": {
			"type": "number",
			"default": 50
		},
		"height": {
			"type": "string",
			"default": "540"
		},
		"heightTablet": {
			"type": "string",
			"default": ""
		},
		"heightMobile": {
			"type": "string",
			"default": ""
		},
		"containerRadius": {
			"type": "object",
			"default": {
				"top": "",
				"right": "",
				"bottom": "",
				"left": ""
			}
		},
		"hideDesktop": {
			"type": "boolean",
			"default": false
		},
		"hideTablet": {
			"type": "boolean",
			"default": false
		},
		"hideMobile": {
			"type": "boolean",
			"default": false
		},
		"showLabels": {
			"type": "boolean",
			"default": false
		},
		"beforeLabel": {
			"type": "string",
			"default": "Before"
		},
		"afterLabel": {
			"type": "string",
			"default": "After"
		},
		"labelsOnHover": {
			"type": "boolean",
			"default": false
		},
		"labelPosition": {
			"type": "string",
			"default": "center"
		},
		"labelOffset": {
			"type": "string",
			"default": ""
		},
		"labelColor": {
			"type": "string",
			"default": ""
		},
		"labelBg": {
			"type": "string",
			"default": ""
		},
		"labelBgGradient": {
			"type": "string",
			"default": ""
		},
		"labelTypography": {
			"type": "object",
			"default": {}
		},
		"labelPadding": {
			"type": "object",
			"default": {}
		},
		"labelRadius": {
			"type": "object",
			"default": {
				"top": "",
				"right": "",
				"bottom": "",
				"left": ""
			}
		}
	}
}
