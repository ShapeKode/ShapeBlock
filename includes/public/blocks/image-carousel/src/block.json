{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "shapeblock/image-carousel",
	"version": "0.1.0",
	"title": "Image Carousel",
	"category": "shapeblock",
	"description": "A multi-image carousel with centred slides and continuous scrolling.",
	"keywords": [ "carousel", "images", "logos", "marquee", "slider" ],
	"example": {},
	"supports": {
		"html": false,
		"align": [ "left", "center", "right", "wide", "full" ]
	},
	"textdomain": "shapeblock",
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"attributes": {
		"blockId": { "type": "string", "default": "" },

		"images": {
			"type": "array",
			"default": [ { "image": {} }, { "image": {} }, { "image": {} }, { "image": {} } ]
		},

		"slidesPerView": { "type": "string", "default": "3" },
		"slidesPerViewTablet": { "type": "string", "default": "2" },
		"slidesPerViewMobile": { "type": "string", "default": "1" },
		"spaceBetween": { "type": "string", "default": "20" },
		"spaceBetweenTablet": { "type": "string", "default": "" },
		"spaceBetweenMobile": { "type": "string", "default": "" },

		"centeredSlides": { "type": "boolean", "default": false },
		"inactiveScale": { "type": "string", "default": "" },
		"inactiveOpacity": { "type": "string", "default": "" },

		"loop": { "type": "boolean", "default": true },
		"autoplay": { "type": "boolean", "default": true },
		"autoplayDelay": { "type": "string", "default": "3000" },
		"pauseOnHover": { "type": "boolean", "default": true },
		"speed": { "type": "string", "default": "600" },
		"marquee": { "type": "boolean", "default": false },
		"marqueeSpeed": { "type": "string", "default": "4000" },
		"showArrows": { "type": "boolean", "default": true },
		"showDots": { "type": "boolean", "default": false },

		"slideHeight": { "type": "string", "default": "260" },
		"slideHeightTablet": { "type": "string", "default": "" },
		"slideHeightMobile": { "type": "string", "default": "" },
		"imageFit": { "type": "string", "default": "cover" },
		"imageSize": { "type": "string", "default": "thumbnail" },
		"slidePadding": { "type": "object" },
		"slidePaddingTablet": { "type": "object" },
		"slidePaddingMobile": { "type": "object" },

		"slideBg": { "type": "string", "default": "" },
		"slideRadius": { "type": "object" },
		"slideBorder": { "type": "object", "default": { "width": 0, "color": "", "style": "solid" } },
		"overlayColor": { "type": "string", "default": "" },
		"overlayGradient": { "type": "string", "default": "" },

		"arrowColor": { "type": "string", "default": "" },
		"arrowBgColor": { "type": "string", "default": "" },
		"arrowSize": { "type": "string", "default": "" },
		"arrowSizeTablet": { "type": "string", "default": "" },
		"arrowSizeMobile": { "type": "string", "default": "" },
		"arrowRadius": { "type": "object" },

		"dotColor": { "type": "string", "default": "" },
		"dotActiveColor": { "type": "string", "default": "" },
		"dotSize": { "type": "string", "default": "" }
	}
}
